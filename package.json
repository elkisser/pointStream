{
  "name": "pointstream",
  "version": "1.4.0",
  "description": "Monitor de streams de Kick.com y predicciones de CS2 (Forg1 + HLTV) con notificaciones de escritorio",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/**/*.test.js",
    "icon": "electron build/prepare-icon.js",
    "icon:logo": "node build/generate-icon.js",
    "art": "electron build/generate-installer-art.js",
    "telegram:setup": "node build/setup-telegram-bot.js",
    "screenshots": "electron build/capture-screenshots.js",
    "dist": "npm run icon && npm run art && electron-builder && node build/checksums.js",
    "checksums": "node build/checksums.js",
    "pack": "npm run icon && electron-builder --dir"
  },
  "keywords": [
    "kick",
    "stream",
    "monitor",
    "electron",
    "live",
    "streaming"
  ],
  "author": {
    "name": "elkisser",
    "url": "https://github.com/elkisser/pointStream"
  },
  "homepage": "https://github.com/elkisser/pointStream",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.17.0"
  },
  "build": {
    "appId": "com.pointstream.app",
    "productName": "pointStream",
    "copyright": "Copyright © 2026 elkisser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "ui/**/*",
      "assets/**/*",
      "!assets/icon_hd.png",
      "!assets/screenshots/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "PointStream",
      "artifactName": "PointStream-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "license": "LICENSE",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "PointStream ${version}",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PointStream",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false
    }
  }
}
