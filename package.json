{
  "name": "pointstream",
  "version": "1.0.0",
  "description": "Monitor de streams de Kick.com y predicciones de CS2 (Forg1 + HLTV) con notificaciones de escritorio",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron build/prepare-icon.js",
    "icon:logo": "node build/generate-icon.js",
    "art": "node build/generate-installer-art.js",
    "telegram:setup": "node build/setup-telegram-bot.js",
    "screenshots": "electron build/capture-screenshots.js",
    "dist": "npm run icon && npm run art && electron-builder",
    "pack": "npm run icon && electron-builder --dir"
  },
  "keywords": [
    "kick",
    "stream",
    "monitor",
    "electron",
    "live",
    "streaming"
  ],
  "author": "elkisser",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.17.0"
  },
  "build": {
    "appId": "com.pointstream.app",
    "productName": "pointStream",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "pointStream-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "pointStream",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "menuCategory": false
    }
  }
}
