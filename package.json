{
  "name": "kick-stream-monitor",
  "version": "1.0.0",
  "description": "Monitor automático de streams de Kick.com con notificaciones y apertura automática en Brave",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node build/generate-icon.js",
    "dist": "npm run icon && electron-builder",
    "pack": "npm run icon && electron-builder --dir"
  },
  "keywords": [
    "kick",
    "stream",
    "monitor",
    "electron",
    "live",
    "streaming"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.17.0"
  },
  "build": {
    "appId": "com.kickmonitor.app",
    "productName": "Kick Stream Monitor",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "KickStreamMonitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kick Stream Monitor",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true
    }
  }
}
